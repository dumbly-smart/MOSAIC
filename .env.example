# Supabase Dashboard -> Project Settings -> Data API
MOSAIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MOSAIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values. Never expose either value to the frontend.
MOSAIC_SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
MOSAIC_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres

MOSAIC_STORAGE_BUCKET=mosaic-documents
MOSAIC_MAX_UPLOAD_BYTES=52428800
MOSAIC_CORS_ORIGINS=http://localhost:3000
